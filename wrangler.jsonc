// Maintained by Ashraful Zaman — https://www.avirah.com.bd
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fpanel-miniapp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "fpanel.avirah.com.bd",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot", "/hooks/*", "/setup/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notpanel",
      "database_id": "c89ff1e9-5fac-4909-8da3-f1176d610220",
      "migrations_dir": "migrations"
    }
  ],
  // Every minute: order status backup check + the next step of a price sync when one is running/due.
  // At minute :07 of each hour it also runs cleanup (old webhook events, stale pending payments).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Optional: comma-separated Telegram user IDs that are always admins. More admins can be claimed or added in the app.
    "OWNER_IDS": "7908843804",
    // Local development only (set in .dev.vars). Must stay empty in production.
    "DEV_FAKE_USER_ID": ""
  }
}
